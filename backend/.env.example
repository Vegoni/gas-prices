# EIA API Key
# Get yours free at: https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_api_key_here

# Database URL (SQLite for local dev)
# On Fly, this is set automatically by the Dockerfile to /data/gas_prices.db (the persistent volume)
DATABASE_URL=sqlite+aiosqlite:///./gas_prices.db

# How often to fetch new data (in hours) — EIA updates weekly on Mondays
FETCH_INTERVAL_HOURS=168

# Comma-separated list of origins allowed to call the API (CORS).
# Local dev defaults are baked in; in production set this to your deployed frontend URL.
# CORS_ALLOW_ORIGINS=https://your-frontend.pages.dev
